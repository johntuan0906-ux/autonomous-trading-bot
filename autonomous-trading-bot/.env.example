# ---- Binance Futures ----
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_TESTNET=true

# ---- Bot behaviour ----
DRY_RUN=true
POLL_INTERVAL_SEC=60
TIMEFRAME=15m
OHLCV_LIMIT=200
LEVERAGE=8
RISK_PER_TRADE_PCT=1.0
BALANCE_USDT=1000.0

# ---- Universe (mo rong cho testnet, KHONG anh huong risk/entry) ----
# SYMBOLS: cac cap bot luon quet (mac dinh: BTC,ETH,SOL,XRP /USDT:USDT).
# EXTRA_SYMBOLS: cap MO RONG them khi muon tang van toc thu mau testnet.
#   - Chi la tang khong gian tim setup dat alpha; nguong MIN_ALPHA_SCORE/MIN_EDGE
#     va 1% risk/lenh GIU NGUYEN, tran MAX_TOTAL_RISK_PCT van chan so vi the mo
#     dong thoi -> them cap khong lam tang rui ro tai khoan.
#   - Vi du: EXTRA_SYMBOLS=ADA/USDT:USDT,DOGE/USDT:USDT,LINK/USDT:USDT,AVAX/USDT:USDT
#   - Khong duoc trung voi SYMBOLS (config se bao loi), comma-separated.
SYMBOLS=BTC/USDT:USDT,ETH/USDT:USDT,SOL/USDT:USDT,XRP/USDT:USDT
EXTRA_SYMBOLS=

# ---- Strategy weights / thresholds ----
W_TECH=0.65
W_SENT=0.35
MIN_ALPHA_SCORE=0.35
MIN_EDGE=0.10
MAX_POSITIONS=4
ALLOW_HEDGE_OPPOSITE=false

# ---- Risk (GIA TRI KHUYEN NGHI cho LIVE — .env dang chay co the khac) ----
# Luu y: tran TONG risk danh muc (MAX_TOTAL_RISK_PCT) moi la rang buoc that; cua LIVE
# la <= 2.0. LEVERAGE <= 10, va <= 8 khi PF < 1.5 (live_guard.py kiem tra).
ATR_PERIOD=14
SL_ATR_MULT=1.5
TP_ATR_MULT=3.0
MAX_DAILY_LOSS_PCT=2.0
MAX_ATR_PCT=0.05
MAX_CONSECUTIVE_ERRORS=5

# ---- Sentiment ----
CRYPTOPANIC_TOKEN=
SENTIMENT_CACHE_SEC=300
BLOCK_LONG_BELOW=-0.5
BLOCK_SHORT_ABOVE=0.5
USE_LLM_SENTIMENT=false
OPENAI_API_KEY=

# ---- Quan ly lenh dong (trade management) ----
PARTIAL_AT_R=1.0
PARTIAL_PCT=0.5
BE_AT_R=1.0
TRAIL_ATR_MULT=1.0

# ---- An toan P0 (chong mat tien that) ----
# Notional toi thieu cua san: vi the con lai nho hon muc nay KHONG the dong bang
# lenh -> bot coi nhu da dong (ghi CLOSE vao journal) thay vi giu 'xac' lenh 0.01 lot.
# Binance USDT-M live = 5; DEMO co luc doi 20 (loi -4164) -> mac dinh 20 cho an toan.
MIN_NOTIONAL_USDT=20

# Tran TONG risk dong thoi (% equity). MAX_POSITIONS x RISK_PER_TRADE_PCT phai <= muc nay.
# Vi du: 4 vi the x 1% = 4% > MAX_DAILY_LOSS_PCT 2% -> dat 3% (moi len live nen de 2.0).
MAX_TOTAL_RISK_PCT=2.0
# Khi khoi dong lai: doc vi the THAT tren san va tiep tuc quan ly (khong mo trung).
ADOPT_POSITIONS=true
# Doi soat lenh bao ve (SL/TP) tren san: kiem tra MOI VONG cho cap nao chua xac nhan du
# bao ve, nhung toi da 1 lan/cap trong PROTECT_CHECK_SEC giay (tranh spam API).
# SL tren san bi mat/huy -> phat hien trong ~1 vong (truoc 02/10: toi 5 vong).
PROTECT_CHECK_SEC=60
ROUND_TIMEOUT_SEC=90
SOCKET_TIMEOUT_SEC=20
# Supervisor watchdog (run_forever.py): nhip tim cu hon bao nhieu giay -> coi nhu treo -> kill.
# 360s: ADOPT vi the + arm SL/TP cho nhieu cap co the lau; 180s tung lam kill bot
# dang lam viec that (01/10). Bot ghi nhip tim moi vong + truoc/sau ADOPT.
# Ngan sach thoi gian (giay) cho 1 lan lay tin RSS (15 feed x timeout 20s = ~300s neu mang
# bi chan -> treo duong bao ve SL/TP). Het ngan sach -> bo cac feed con lai (khong treo).
SENTIMENT_BUDGET_SEC=15

# Nguong "lo khong dang ke" (USDT) cho chuoi thua lien tiep: |pnl| nho hon muc nay khong
# tinh la 1 lan thua (va cung khong reset chuoi). Vi sao: 01/10 mot lenh dong do DUST voi
# pnl=-0.0011 USDT bi tinh la lan thua thu 5 -> TRIP kill-switch oan.
MIN_LOSS_USDT=0.5

WATCHDOG_SEC=360
# Kill-switch dang ngung: true = CHI quan ly vi the dang mo (khong mo lenh moi, van monitor
# mem + thu arm lai SL/TP, tu quay lai trade khi ban chay `python risk.py --reset`).
# false = hanh vi cu: thoat han + de supervisor restart (vi the se KHONG duoc quan ly).
KILL_MONITOR_ONLY=true
RISK_STATE_PATH=logs/risk_state.json
MANAGED_STATE_PATH=logs/managed_state.json

# ---- P0-reconcile: doi chieu journal voi fill san, ghi bu CLOSE bi thieu ----
# Vi sao: bot tat/restart khi dang mo vi the -> san dong bang SL/TP ma khong ai
# ghi CLOSE -> n/WR/PF/LONG-SHORT thieu -> gate LIVE bi lech (co the DE hon thuc te).
# Chi ghi logs/journal.jsonl (co backup .bak-*), KHONG sua risk_state, KHONG vao lenh.
RECONCILE_JOURNAL=true
# Chi lay fill trong N ngay (Binance gioi han userTrades 7 ngay/request).
RECONCILE_DAYS=7
# Tran tan suat quet (giay) — supervisor spawn lai nhieu lan, tranh goi API lien tuc.
RECONCILE_MIN_INTERVAL_SEC=3600

# ---- Strategy gate: chan setup thuoc strategy dang am (khong ha nguong entry) ----
# AUTO (tu logs/strategy_stats.json): n >= STRAT_MIN_N va avgR <= -STRAT_AVG_R -> chan.
# Block chi lam GIAM so lenh (khong tang rui ro); muon tat het: STRATEGY_GATE=false.
STRATEGY_GATE=true
STRAT_MIN_N=10
STRAT_AVG_R=0.10
# BLOCKLIST chu dong: chi chan khi da co bang chung am tu BACKTEST rat ro (khong cho
# doi du mau journal). Vi du A_TREND_PULLBACK: 30 ngay x 8 cap n=394 avgR=-0.056.
STRATEGY_BLOCK=

# ---- Phase 1: tang multi-AI agent (CHI CO VAN — khong sua lenh/risk) ----
# Agent tra ve y kien (ALLOW/VETO/NO_OPINION) va ghi journal (event=AGENT).
# KHONG duoc doi qty/SL/TP/kill-switch; khong dat/huy lenh (xem README muc 6b).
AGENTS_ENABLED=false          # bat len thuong truoc (khuyen nghi: shadow 1 tuan)
AGENTS_SHADOW=true            # true = chi ghi nhan, khong doi hanh vi bot
AGENT_PROVIDER=stub           # stub | openai | anthropic | copilot_cli | vscode_lm | openai_compatible
AGENT_MODEL=                  # trong = mac dinh theo provider
# --- Phase 2 voi Copilot Pro (KHONG can API key rieng) ---
# copilot_cli: dung GitHub Copilot CLI (chinh thuc) o che do -p (programmatic).
#   Can: npm install -g @github/copilot  +  copilot login
#   (hoac dat COPILOT_GITHUB_TOKEN = PAT v2 co quyen "Copilot Requests")
# vscode_lm: POST toi bridge extension vscode_lm_bridge/ dang chay trong VS Code.
# Provider copilot_cli: `node` duoc TU DONG resolve sang duong dan that (agents.py
# _resolve_exe: PATH -> C:\Program Files\nodejs\node.exe -> %APPDATA%\npm) vi tien
# trinh pythonw do supervisor spawn co the khong co node trong PATH.
AGENT_COPILOT_BIN=node C:\Users\me\AppData\Roaming\npm\node_modules\@github\copilot\npm-loader.js
# Them flag chan tool neu muon chat: "-p {prompt} --model {model} --deny-tool write"
AGENT_COPILOT_ARGS=-p {prompt}
AGENT_VSCODE_LM_URL=http://127.0.0.1:8765/complete
AGENT_VSCODE_LM_TOKEN=
# openai_compatible: BYOK cho Azure/OpenRouter/Ollama/vLLM (khong lien quan Copilot)
# AGENT_COMPAT_BASE_URL=https://openrouter.ai/api/v1
# AGENT_COMPAT_MODEL=meta-llama/llama-3.3-70b-instruct
# AGENT_COMPAT_API_KEY=...
AGENT_TIMEOUT_SEC=6
AGENT_CACHE_SEC=900           # cung 1 nen -> 1 cuoc goi (tiet kiem tien/credit)
AGENT_DAILY_CALLS=200         # tran cung moi ngay (UTC)
AGENT_DAILY_BUDGET_USD=1.0    # tran chi phi moi ngay; vuot -> agent tu TAT
AGENT_MAX_ERRORS=5            # loi lien tiep -> circuit breaker (tat agent)
AGENT_MAX_PROMPT_TOKENS=1200
AGENT_STATE_PATH=logs/agent_state.json

# ---- Phase 3: agent phan tich -> de xuat (GATE TAT DINH, khong tu ap dung) ----
# python agents.py --reflect         # 1 luot: doc so lieu that -> de xuat
# python agents.py --proposals 3     # xem de xuat gan nhat
# python agents.py --apply 0 --yes   # ap dung (CHI block/unblock; backup .env truoc khi ghi)
AGENT_PROPOSALS_PATH=logs/agent_proposals.jsonl
REFLECT_MIN_N=20                     # de xuat block can toi thieu bao nhieu lenh

# ---- Phase 4: cap quyen VETO cho agent (MAC DINH TAT + phai co bang chung) ----
# Chi bat khi: python agents.py --authority -> granted=True
#   (n_veto >= AGENT_VETO_MIN_N VA n_allow >= AGENT_VETO_MIN_ALLOW
#    VA avgR_veto <= avgR_allow - AGENT_VETO_MIN_GAP)
# Quyen veto CHI duoc BO QUA 1 lenh (giam rui ro); khong the tang size/doi SL/TP/dong lenh.
AGENTS_VETO_ENABLED=false
AGENT_VETO_MIN_CONF=0.7              # chi chan khi VETO + confidence >= muc nay
AGENT_VETO_MIN_N=10                  # so lenh shadow toi thieu cua nhom VETO
# (08/10) PHAI du ca 2 nhom: chi doi n_veto thi 1 lenh ALLOW la du de "chung minh"
# -> cap quyen veto tren mau vo nghia (thuc te 08/10: COUNCIL granted=True voi n_allow=1).
AGENT_VETO_MIN_ALLOW=10              # so lenh shadow toi thieu cua nhom ALLOW
AGENT_VETO_MIN_GAP=0.15              # VETO phai te hon ALLOW it nhat bao nhieu R
# Tu dong ap dung de xuat block/unblock (sau gate tat dinh) — MAC DINH TAT.
AGENT_AUTO_APPLY=false

# ---- Council (hoi dong 2 vong + chu toa): macro -> critic (doc y kien macro) -> arbiter
# Quy tac quorum TAT DINH: 2 VETO -> VETO | 2 ALLOW -> ALLOW | chia phieu -> chu toa quyet.
# Van la SHADOW. Chay thu: python agents.py --council-test SOL/USDT:USDT SHORT
AGENTS_COUNCIL=false
AGENT_TG_VOTES=false
# Nguon bang chung cap quyen veto: SETUP (macro/critic) hoac COUNCIL (chu toa).
AGENT_VETO_SOURCE=SETUP

# ---- Multi-AI: hoi dong 14 model ClinePass (code/phan tich, KHONG dung de trade) ----
# Key: app.cline.bot -> Settings -> API Keys. 1 key dung cho ca 14 model.
# Chay (mock = offline, khong ton quota):
#   python clinepass_review.py --task safety_audit --bundle safety
#   python clinepass_review.py --task code_review --file turbo_demo.py --provider clinepass --tg
CLINE_API_KEY=
CLINE_CONCURRENCY=3
CLINE_REQUEST_TIMEOUT=300
CLINE_RUN_TIMEOUT=1200
CLINE_MAX_RETRIES=2
CLINE_MAX_CALLS=45
# 60000: 2 file code (~28k) + bundle (~18k) = ~46k -> 20000 se bi harness tu choi.
CLINE_MAX_CONTEXT_CHARS=60000
# Model bo qua khi --group all (vi du model hay treo/timeout voi prompt lon).
# 08/10: them muse-spark-1.3-contributor de "bo hoan toan Muse khoi hoi dong".
CLINE_SKIP_MODELS=cline-pass/glm-5.3-flash,cline-pass/muse-spark-1.3-contributor
CLINE_SUMMARY_CHARS_PER_AGENT=1500
# Tuy chon: dung chinh key nay lam provider cho hoi dong trading (agents.py):
#   AGENT_PROVIDER=openai_compat
#   AGENT_COMPAT_BASE_URL=https://api.cline.bot/api/v1
#   AGENT_COMPAT_API_KEY=<cung gia tri CLINE_API_KEY>
#   AGENT_COMPAT_MODEL=cline-pass/glm-5.3

# ---- Hoi dong NHIEU MODEL THAT (khac AGENTS_COUNCIL o tren: khong phai 1 model
# dong 3 vai, ma la nhieu model that hoi SONG SONG, khong co model nao "duoc chon
# hop ly nhat" — quyet dinh la quorum ALLOW/VETO cua cac phieu that con lai, model
# treo/loi bi loai nhu phieu trang). Can AGENT_PROVIDER=copilot_cli + da dang nhap.
# Trong AGENT_COUNCIL_MODELS = dung agents.COUNCIL_MULTI_MODELS (da kiem chung qua
# CLI 01/10/2026: claude-sonnet-5.5, claude-sonnet-5, claude-haiku-4.5,
# gemini-3.8-flash, grok-4.6, kimi-k3, gpt-5.6-terra).
# Chay thu: python agents.py --council-multi-test SOL/USDT:USDT SHORT
AGENTS_COUNCIL_MULTI_MODEL=false
AGENT_COUNCIL_MODELS=
# Model Cline (cline-pass/...) tham gia CHUNG hoi dong voi Copilot CLI:
#   all  = doc catalog Multi_AI_Agent/models.clinepass.json (14 model, tru CLINE_SKIP_MODELS)
#   csv  = danh sach cu the; rong = khong dung Cline (chi Copilot)
AGENT_COUNCIL_CLINE=
# Model Muse (Meta Model API) tham gia CHUNG hoi dong voi Cline va Copilot:
#   csv  = danh sach model (vd: muse-spark-1.3,muse-spark-1.2)
#   rong = khong dung Muse (chi Copilot + Cline)
# Can dang ky API key tai https://dev.meta.ai (MUSE_API_KEY ben duoi).
# Muse Spark ~$1.25/M in, $4.25/M out; contributor tier re hon nhung Meta train tren data.
AGENT_COUNCIL_MUSE=
MUSE_API_KEY=
MUSE_SKIP_MODELS=
# (05/10) Tam nghi 1 bo hoi dong theo ngay (ISO YYYY-MM-DD): provider do bi BO QUA den het
# ngay nay (vd Copilot het quota hang thang -> AGENT_COUNCIL_COPILOT_UNTIL=2026-11-01).
# Rong = khong chan. Provider con lai TU LAM 100%, khong treo, khong ngat viec.
AGENT_COUNCIL_COPILOT_UNTIL=
AGENT_COUNCIL_CLINE_UNTIL=
AGENT_COUNCIL_MUSE_UNTIL=
# --- (08/10) Muse Code CLI (muse exec headless) — DA TAT MAC DINH ----------------------
#   csv = model Muse (vd: muse-spark-1.2); rong = tat (mac dinh nay dang la RONG).
#   (08/10) KET LUAN DIEU TRA: browser sign-in (`muse login`) tra
#   `credential.login outcome="mint_failed"` (4/4 lan) -> CLI tu xoa credential.
#   Docs dev.meta.ai/docs/muse-code/auth: tai khoan MMA (Business & Enterprise)
#   KHONG dung duoc browser sign-in -> BAT BUOC API key + billing/credit:
#     - `muse auth set` (dan key, luu ~/.config/muse/auth.json, khong can restart), hoac
#     - dat META_API_KEY=<key> (uu tien cao nhat; CLI ke thua env cua tien trinh bot).
#   => Chua nap credit nen da TAT khoi hoi dong (khong con vote Muse). Bat lai: dien model
#      vao AGENT_COUNCIL_MUSE_CLI sau khi co key. Code provider van con (fail-open).
AGENT_COUNCIL_MUSE_CLI=
AGENT_COUNCIL_MUSE_CLI_UNTIL=
AGENT_MUSE_CLI_BIN=muse
AGENT_MUSE_CLI_ARGS=exec {prompt} --max-model-steps 2 --disable-approval
MUSE_CLI_SKIP_MODELS=
# --- (08/10) Provider thu 4: Qwen Code headless (QwenLM/qwen-code) -------------------
#   csv = model Qwen (vd: qwen3-coder-plus,qwen3-coder-flash); rong = tat.
AGENT_COUNCIL_QWEN=
AGENT_COUNCIL_QWEN_UNTIL=
AGENT_QWEN_BIN=qwen
AGENT_QWEN_ARGS=-p {prompt} -o text --approval-mode plan --auth-type openai
QWEN_SKIP_MODELS=
# --- (08/10) Chong treo/quota + tiet kiem chi phi ------------------------------------
# Retry loi tam thoi (429/5xx/timeout) truoc khi NO_OPINION: tong so lan goi 1 model.
AGENT_RETRY_ATTEMPTS=2
# Tran chi phi THEO VONG council (USD); 0 = tat (chi co tran/ngay). Vi du 0.10.
AGENT_ROUND_BUDGET_USD=0
# Provider exhausted lan 1 -> PAUSE giay nay roi tu mo lai; lan 2 cung session -> block han.
AGENT_PROVIDER_PAUSE_SEC=1800
# Fallback chain: 'primary>f1,f2|primary2>g1' (vd muse-spark-1.3>muse-glimmer-30b).
AGENT_COUNCIL_FALLBACKS=
# Alias trung lap: 'alias=canonical,...' (2 ten cung 1 model that chi tinh 1 phieu).
AGENT_COUNCIL_ALIASES=
# --- (08/10) Bang quyet dinh kien truc: single / urgent / local ----------------------
# JSON repair: model tra van ban thay vi JSON -> hoi lai 1 lan voi chi dan cuc chat.
AGENT_JSON_REPAIR=true
# Viec QUA DE (do kho <= nguong) -> chi hoi 1 model (SINGLE LLM CALL). 0 = tat.
AGENT_COUNCIL_SINGLE_BELOW=0
# URGENT (kieu LPU - do tre thap): tin khan cap >= AGENT_URGENT_MIN -> dung danh sach nay.
AGENT_COUNCIL_URGENT=
AGENT_URGENT_MIN=10
# LOCAL mien phi (kieu NPU: $0, private): Ollama/vLLM/llama.cpp chay tai may.
#   winget install Ollama.Ollama  ->  ollama pull llama3.2:3b  ->  AGENT_COUNCIL_LOCAL=llama3.2:3b
AGENT_COUNCIL_LOCAL=
AGENT_COUNCIL_LOCAL_UNTIL=
AGENT_LOCAL_BASE_URL=http://127.0.0.1:11434/v1
AGENT_LOCAL_API_KEY=ollama
# Model local chay CPU cham (3B ~ 10-30s/cau) -> timeout rieng thay vi 6s cua API.
AGENT_LOCAL_TIMEOUT_SEC=180
LOCAL_SKIP_MODELS=
# (05/10) TIER MOTEL THEO DO KHO: de -> model lite (flash/mini) tiet kiem token + nhanh;
# kho -> model pro/max thong minh xu ly ky. So do kho tu dong tinh tu RSI/ATR/news/urgent/
# alpha/vol_ratio. Khi vong dau chia re/hoa -> tu NANG CAP tier (lite->core->hard) + vote
# lai voi nhieu model thong minh hon. Chung cho CA Cline va Copilot.
#   COUNCIL_ROUNDS=2  (debate 2 vong, mac dinh) | 1 = tat debate/tier escalation
COUNCIL_ROUNDS=2
# Ngan sach LINH HOAT theo do kho (mac dinh BAT): van de de (dong thuan, it phieu
# trang) -> dung nguyen AGENT_TIMEOUT_SEC/AGENT_DAILY_CALLS/BUDGET o tren, khong
# ton them. Van de kho (hoa phieu HOAC >= ty le duoi day model bi treo) -> tu dong
# hoi LAI cac model treo voi ngan sach "hard" (co y RAT CAO, bo qua chi phi).
AGENT_BUDGET_ADAPTIVE=true
AGENT_HARD_ABSTAIN_RATIO=0.3
AGENT_TIMEOUT_SEC_HARD=240
AGENT_DAILY_CALLS_HARD=2000
AGENT_DAILY_BUDGET_USD_HARD=1000.0

# ---- Phase 5: INTERLOCK LIVE (live_guard.py) ----
# Doi BINANCE_TESTNET=false KHONG du: interlock chan cung neu:
#   LIVE_CONFIRM != true | n_dong < 50 | PF(R) < 1.2 | MAX_TOTAL_RISK_PCT > 2
#   | LEVERAGE > 10 | LEVERAGE > 8 khi PF < 1.5 | kill-switch dang tripped
# Kiem tra: python live_guard.py
LIVE_CONFIRM=false

