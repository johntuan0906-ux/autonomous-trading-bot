# Mock = demo co dinh, khong goi AI. CLI --provider se uu tien hon dong nay.
PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# De trong de dung OPENAI_MODEL. Co the dung model khac cho tung vai tro.
MODEL_MANAGER=
MODEL_PLANNER=
MODEL_BUILDER=
MODEL_REVIEWER=
MODEL_FINALIZER=

MAX_TURNS=6
MAX_CALLS=16
MAX_OUTPUT_TOKENS=2200
MAX_CONCURRENCY=3
MAX_RETRIES=2
REQUEST_TIMEOUT_SECONDS=90
RUN_TIMEOUT_SECONDS=600
MAX_CONTEXT_CHARS=20000
