# ============================================================
# Sao chép file này thành ".env" rồi điền thông tin thật vào.
# TUYỆT ĐỐI không commit file ".env" (chứa key thật) lên Git.
# ============================================================

# --- Binance API ---
BINANCE_API_KEY=your_api_key_here
BINANCE_API_SECRET=your_api_secret_here

# true = kết nối Binance Futures TESTNET (tiền ảo, khuyến nghị khi mới chạy)
# false = kết nối MAINNET (tiền thật)
USE_TESTNET=true

# --- An toàn ---
# true = bot chỉ MÔ PHỎNG lệnh (ghi log), KHÔNG gửi lệnh thật lên sàn.
# Chỉ đặt false khi đã test kỹ trên testnet và hiểu rõ rủi ro.
DRY_RUN=true

# --- Nguồn tin tức (tuỳ chọn) ---
# Để trống thì bot vẫn chạy bình thường, chỉ là điểm tin tức sẽ luôn = 0 (trung lập).
CRYPTOPANIC_API_KEY=
NEWSAPI_API_KEY=

# --- Thông báo Telegram (tuỳ chọn) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
